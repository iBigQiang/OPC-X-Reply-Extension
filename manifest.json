{
  "manifest_version": 3,
  "name": "X 推文互动回复器",
  "version": "2.1.4",
  "description": "X 推文互动回复器 v2.1：支持 8 个 API 渠道（OpenAI-Chat/Response、Gemini、Anthropic、New API、Sub2API、api2d、自定义），每个渠道独立配置缓存，Base URL 智能自动补全（根域名 / 带 /v1 / 完整 endpoint / # 终止符 都能识别）并实时预览，API Key 输入框支持密码可见性切换。一次生成 3 条可编辑回复候选，手动选择复制或填入，不自动发送。",
  "icons": {
    "16": "img/i_16.png",
    "32": "img/i_32.png",
    "48": "img/i_48.png",
    "128": "img/i_128.png"
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.openai.com/*",
    "https://oa.api2d.net/*",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "X 推文互动回复器",
    "default_icon": {
      "16": "img/i_16.png",
      "32": "img/i_32.png",
      "48": "img/i_48.png",
      "128": "img/i_128.png"
    }
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "img/i_16.png",
        "img/i_32.png",
        "img/i_48.png",
        "img/i_128.png",
        "img/Qiangge.png",
        "img/options_bg.png"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ]
    }
  ]
}
